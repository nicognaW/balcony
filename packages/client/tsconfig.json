{
  // The client runs in browsers, React Native and Bun; all of them have a
  // global WebSocket, typed here by DOM, and ES2022: the Android app's
  // Hermes has no ES2023 array methods (toSorted, toReversed, findLast).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"]
  },
  "include": ["**/*"]
}
